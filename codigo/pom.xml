<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.edu.projeto</groupId>
    <artifactId>diarios-oficiais</artifactId>
    <version>1.1</version>
    <packaging>jar</packaging>
    <name>Diarios Oficiais</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.5</javafx.version>
        <sqlite.version>3.46.1.3</sqlite.version>
        <junit.version>5.11.3</junit.version>
        <jackson.version>2.18.2</jackson.version>
        <atlantafx.version>2.1.0</atlantafx.version>
        <classe.principal>diarios.servidor.Servidor</classe.principal>
    </properties>

    <dependencies>
        <!-- Interface desktop. O Maven escolhe sozinho o binario do seu sistema (win, linux, mac). -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- Temas modernos (claro/escuro) para a interface JavaFX. -->
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>
        <!-- Banco de dados embutido: um arquivo .db, sem instalar servidor. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>
        <!-- Leitura de JSON (respostas da API do Querido Diario e da BrasilAPI). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <!-- Testes (so no teste, nao vai para o programa). -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- mvn test: os testes leem dados/diarios, que fica na raiz do repositorio. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <workingDirectory>${project.basedir}/..</workingDirectory>
                    <includes>
                        <include>**/Testes*.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${classe.principal}</mainClass>
                            <!-- java -jar enxerga as bibliotecas na pasta lib/ ao lado do jar -->
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${classe.principal}</mainClass>
                </configuration>
            </plugin>
            <!-- mvn javafx:run abre a janela desktop -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>diarios.desktop.Janela</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
